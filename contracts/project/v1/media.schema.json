{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:palmier:contract:media:v1",
  "title": "Palmier media.json complete known-field contract",
  "type": "object",
  "properties": {
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "entries": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/entry"
      }
    },
    "folders": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/mediaFolder"
      }
    }
  },
  "additionalProperties": true,
  "$defs": {
    "clipType": {
      "type": "string",
      "enum": [
        "video",
        "audio",
        "image",
        "text",
        "lottie",
        "sequence"
      ]
    },
    "entry": {
      "type": "object",
      "required": [
        "id",
        "name",
        "type",
        "source",
        "duration"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "type": {
          "$ref": "#/$defs/clipType"
        },
        "source": {
          "$ref": "#/$defs/source"
        },
        "duration": {
          "type": "number",
          "minimum": 0
        },
        "generationInput": {
          "$ref": "#/$defs/nullableGenerationInput"
        },
        "sourceWidth": {
          "type": [
            "integer",
            "null"
          ]
        },
        "sourceHeight": {
          "type": [
            "integer",
            "null"
          ]
        },
        "sourceFPS": {
          "type": [
            "number",
            "null"
          ]
        },
        "hasAudio": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "folderId": {
          "type": [
            "string",
            "null"
          ]
        },
        "cachedRemoteURL": {
          "type": [
            "string",
            "null"
          ]
        },
        "cachedRemoteURLExpiresAt": {
          "type": [
            "number",
            "null"
          ]
        },
        "generationStatus": {
          "type": [
            "string",
            "null"
          ]
        },
        "importInput": {
          "$ref": "#/$defs/nullableMediaImportInput"
        }
      },
      "additionalProperties": true
    },
    "source": {
      "oneOf": [
        {
          "type": "object",
          "required": [
            "external"
          ],
          "properties": {
            "external": {
              "type": "object",
              "required": [
                "absolutePath"
              ],
              "properties": {
                "absolutePath": {
                  "type": "string"
                }
              },
              "additionalProperties": true
            }
          },
          "not": {
            "required": [
              "project"
            ]
          },
          "additionalProperties": true
        },
        {
          "type": "object",
          "required": [
            "project"
          ],
          "properties": {
            "project": {
              "type": "object",
              "required": [
                "relativePath"
              ],
              "properties": {
                "relativePath": {
                  "type": "string"
                }
              },
              "additionalProperties": true
            }
          },
          "not": {
            "required": [
              "external"
            ]
          },
          "additionalProperties": true
        }
      ]
    },
    "nullableGenerationInput": {
      "type": [
        "object",
        "null"
      ],
      "required": [
        "prompt",
        "model",
        "duration",
        "aspectRatio"
      ],
      "properties": {
        "prompt": {
          "type": "string"
        },
        "model": {
          "type": "string"
        },
        "duration": {
          "type": "integer"
        },
        "aspectRatio": {
          "type": "string"
        },
        "resolution": {
          "type": [
            "string",
            "null"
          ]
        },
        "upscaleSettings": {
          "$ref": "#/$defs/nullableUpscaleSettings"
        },
        "upscaleSourceWidth": {
          "type": [
            "integer",
            "null"
          ]
        },
        "upscaleSourceHeight": {
          "type": [
            "integer",
            "null"
          ]
        },
        "upscaleSourceFPS": {
          "type": [
            "number",
            "null"
          ]
        },
        "quality": {
          "type": [
            "string",
            "null"
          ]
        },
        "imageURLs": {
          "$ref": "#/$defs/nullableStringArray"
        },
        "numImages": {
          "type": [
            "integer",
            "null"
          ]
        },
        "voice": {
          "type": [
            "string",
            "null"
          ]
        },
        "lyrics": {
          "type": [
            "string",
            "null"
          ]
        },
        "styleInstructions": {
          "type": [
            "string",
            "null"
          ]
        },
        "instrumental": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "targetLanguage": {
          "type": [
            "string",
            "null"
          ]
        },
        "multilingual": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "audioInput": {
          "type": [
            "string",
            "null"
          ]
        },
        "generateAudio": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "referenceImageURLs": {
          "$ref": "#/$defs/nullableStringArray"
        },
        "referenceVideoURLs": {
          "$ref": "#/$defs/nullableStringArray"
        },
        "referenceAudioURLs": {
          "$ref": "#/$defs/nullableStringArray"
        },
        "imageURLAssetIds": {
          "$ref": "#/$defs/nullableStringArray"
        },
        "referenceImageAssetIds": {
          "$ref": "#/$defs/nullableStringArray"
        },
        "referenceVideoAssetIds": {
          "$ref": "#/$defs/nullableStringArray"
        },
        "referenceAudioAssetIds": {
          "$ref": "#/$defs/nullableStringArray"
        },
        "createdAt": {
          "type": [
            "number",
            "null"
          ]
        },
        "backendJobId": {
          "type": [
            "string",
            "null"
          ]
        },
        "outputIndex": {
          "type": [
            "integer",
            "null"
          ]
        },
        "resultURLs": {
          "$ref": "#/$defs/nullableStringArray"
        }
      },
      "additionalProperties": true
    },
    "nullableMediaImportInput": {
      "type": [
        "object",
        "null"
      ],
      "properties": {
        "sourceURL": {
          "type": [
            "string",
            "null"
          ]
        },
        "sourcePath": {
          "type": [
            "string",
            "null"
          ]
        },
        "createdAt": {
          "type": [
            "number",
            "null"
          ]
        }
      },
      "additionalProperties": true
    },
    "nullableUpscaleSettings": {
      "type": [
        "object",
        "null"
      ],
      "required": [
        "selections",
        "numbers",
        "toggles"
      ],
      "properties": {
        "selections": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "numbers": {
          "type": "object",
          "additionalProperties": {
            "type": "number"
          }
        },
        "toggles": {
          "type": "object",
          "additionalProperties": {
            "type": "boolean"
          }
        }
      },
      "additionalProperties": true
    },
    "nullableStringArray": {
      "type": [
        "array",
        "null"
      ],
      "items": {
        "type": "string"
      }
    },
    "mediaFolder": {
      "type": "object",
      "required": [
        "id",
        "name"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "parentFolderId": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": true
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:palmier:contract:media:v1",
  "title": "Palmier media.json provisional structural contract",
  "type": "object",
  "properties": {
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "entries": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/entry"
      }
    },
    "folders": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true,
  "$defs": {
    "entry": {
      "type": "object",
      "required": [
        "id",
        "name",
        "type",
        "source",
        "duration"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "type": {
          "type": "string"
        },
        "source": {
          "$ref": "#/$defs/source"
        },
        "duration": {
          "type": "number",
          "minimum": 0
        },
        "generationInput": {
          "type": "object",
          "additionalProperties": true
        },
        "importInput": {
          "type": "object",
          "additionalProperties": true
        }
      },
      "additionalProperties": true
    },
    "source": {
      "oneOf": [
        {
          "type": "object",
          "required": [
            "external"
          ],
          "properties": {
            "external": {
              "type": "object",
              "required": [
                "absolutePath"
              ],
              "properties": {
                "absolutePath": {
                  "type": "string"
                }
              },
              "additionalProperties": true
            }
          },
          "additionalProperties": true
        },
        {
          "type": "object",
          "required": [
            "project"
          ],
          "properties": {
            "project": {
              "type": "object",
              "required": [
                "relativePath"
              ],
              "properties": {
                "relativePath": {
                  "type": "string"
                }
              },
              "additionalProperties": true
            }
          },
          "additionalProperties": true
        }
      ]
    }
  }
}
